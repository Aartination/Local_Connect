{
  "name": "@localhub/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "node-forge": "^1.4.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}

